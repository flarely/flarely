# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/flarely.db

# Redis
REDIS_URL=redis://localhost:6379

# Resend (email handler)
RESEND_API_KEY=re_your_key_here

# Deduplication default window in seconds (10 minutes)
DEFAULT_DEDUP_WINDOW=600

# BullBoard queue dashboard — both must be set or the dashboard is disabled
BULLBOARD_USER=admin
BULLBOARD_PASS=changeme
