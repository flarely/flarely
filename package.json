{
  "name": "flarely",
  "version": "0.1.0",
  "description": "Webhook-based error and event notification service",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/lib.ts --format esm --dts",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "setup": "tsx src/cli/setup.ts",
    "manage": "tsx src/cli/manage.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/fastify": "^7.1.5",
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^9.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.0",
    "nanoid": "^5.0.0",
    "resend": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.27.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
